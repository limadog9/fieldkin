+pub(crate) fn coherent_abbreviation(left: &str, right: &str) -> bool {
+    fn token_prefixes(abbreviation: &str, name: &str) -> bool {
+        let words = name
+            .split(|c: char| !c.is_alphanumeric())
+            .filter(|word| !word.is_empty());
+        // Recognize initials before a greedy prefix consumes the next initial:
+        // in = i(nvoice) + n(umber), rather than in(voice) + nothing.
+        if !abbreviation.is_empty()
+            && words
+                .clone()
+                .filter_map(|word| word.chars().next())
+                .flat_map(char::to_lowercase)
+                .eq(abbreviation.chars())
+        {
+            return true;
+        }
+        let mut remaining = abbreviation.chars().peekable();
+        let mut count = 0;
+        for word in words {
+            let mut letters = word.chars().flat_map(char::to_lowercase);
+            if remaining.next() != letters.next() {
+                return false;
+            }
+            count += 1;
+            for letter in letters {
+                if remaining.peek() != Some(&letter) {
+                    break;
+                }
+                remaining.next();
+            }
+        }
+        count > 0 && remaining.next().is_none()
+    }
+    token_prefixes(&normalize_name(left), right) || token_prefixes(&normalize_name(right), left)
+}
