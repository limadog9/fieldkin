+#[test]
+fn unsupported_renames_abstain_without_hiding_ranked_candidates() {
+    for (left, right) in [
+        (&[][..], &[][..]),
+        (&["married", "single"][..], &["paid", "unpaid"][..]),
+        (&[" ", "\t"][..], &[""][..]),
+    ] {
+        let source = Schema {
+            fields: vec![field("status", DataType::Text, left)],
+        };
+        let target = Schema {
+            fields: vec![field("payment_status", DataType::Text, right)],
+        };
+        let report = match_schemas(&source, &target, Config::default());
+        let best = &report.fields[0].candidates[0];
+        assert!(best.score >= Config::default().min_score);
+        assert_eq!(
+            report.fields[0].decision,
+            Decision::NoMatch {
+                best_score: Some(best.score)
+            }
+        );
+        for max_candidates in [0, 1] {
+            let limited = match_schemas(
+                &source,
+                &target,
+                Config {
+                    max_candidates,
+                    ..Config::default()
+                },
+            );
+            assert_eq!(limited.fields[0].decision, report.fields[0].decision);
+        }
+    }
+}
+
+#[test]
+fn corroborated_renames_and_conventional_abbreviations_still_match() {
+    for (left_name, right_name, left, right) in [
+        (
+            "status",
+            "payment_status",
+            &["open", "paid"][..],
+            &["OPEN", "PAID"][..],
+        ),
+        ("reading", "sensor.reading", &[" 17 "][..], &["17"][..]),
+        ("Population", "POP", &["10", "20"][..], &["30", "40"][..]),
+        ("supplier_key", "vendor_id", &[][..], &[][..]),
+        ("wind_spd", "wspd", &["1", "2"][..], &["1", "2"][..]),
+    ] {
+        let source = Schema {
+            fields: vec![field(left_name, DataType::Text, left)],
+        };
+        let target = Schema {
+            fields: vec![field(right_name, DataType::Text, right)],
+        };
+        let report = match_schemas(&source, &target, Config::default());
+        assert!(
+            matches!(&report.fields[0].decision, Decision::Match { target, .. } if target == right_name),
+            "{left_name} -> {right_name}: {:?}",
+            report.fields[0]
+        );
+    }
+}
