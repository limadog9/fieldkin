+// A necessary acceptance check, not proof that the fields describe the same fact.
+// Keep ranking scores and the existing sample-tie penalty independent of this.
+pub(crate) fn has_selection_evidence(left: &Field, right: &Field) -> bool {
+    let left_name = normalize_name(&left.name);
+    let right_name = normalize_name(&right.name);
+    if left_name.starts_with(&right_name)
+        || right_name.starts_with(&left_name)
+        || tokenize_name(&left.name) == tokenize_name(&right.name)
+        || token_prefix_abbreviation(&left_name, &right.name)
+        || token_prefix_abbreviation(&right_name, &left.name)
+    {
+        return true;
+    }
+
+    // Constant samples earn no ranking bonus, but an observed common value can
+    // still corroborate a rename. Missing/blank values cannot do so.
+    let values: BTreeSet<_> = left
+        .samples
+        .iter()
+        .map(|value| normalize_sample(value))
+        .filter(|value| !value.is_empty())
+        .collect();
+    right
+        .samples
+        .iter()
+        .map(|value| normalize_sample(value))
+        .any(|value| values.contains(&value))
+}
+
+fn token_prefix_abbreviation(abbreviation: &str, name: &str) -> bool {
+    let mut remaining = abbreviation.chars().peekable();
+    let mut words = 0;
+    // Every word must contribute a prefix: c+id is evidence for customer_id;
+    // dropping an entire qualifier (status/payment_status) is not.
+    for word in name
+        .split(|c: char| !c.is_alphanumeric())
+        .filter(|word| !word.is_empty())
+    {
+        let mut letters = word.chars().flat_map(char::to_lowercase);
+        if remaining.next() != letters.next() {
+            return false;
+        }
+        words += 1;
+        for letter in letters {
+            if remaining.peek() != Some(&letter) {
+                break;
+            }
+            remaining.next();
+        }
+    }
+    words > 0 && remaining.next().is_none()
+}
