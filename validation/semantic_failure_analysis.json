  "classification_notes": "Present means a useful contrast exists in supplied names/paths, not that a fix is known or uniquely correct. Partial means plausibility without semantic proof; Missing means the relevant role distinction is absent from the supplied Field. Categories are source-reviewed interpretations, not machine-derived gold labels. Ambiguous actual decisions record count and gold membership instead of copying all candidate names. Evidence document indices refer to evidence_documents.",
  "categories": {
    "hierarchical_leaf_role_not_preserved": {
      "evidence_availability": "present",
      "available_evidence": "Leaf names, parent paths, camelCase word boundaries, and nearby fields distinguish candidates. Flat normalized whole-name similarity allows long common prefixes or generic leaves to dominate. Different parent or terminal labels are evidence to use, not a proof that a rename is invalid."
    },
    "explicit_code_description_role_not_used": {
      "evidence_availability": "present",
      "available_evidence": "Description/code role words are present, sometimes as desc/truncated abbreviations. Token containment ignores extra role words and can tie a description with its code."
    },
    "abbreviation_truncation_and_missing_evidence_gate": {
      "evidence_availability": "present",
      "available_evidence": "Names expose many retained words or abbreviations and all13 gold candidates rank first except highly-compensated-officer (rank10). Source type is Unknown and samples absent. The absolute-evidence gate requires name score at least119/120=.991666..., despite correct normalized ranking. Raising evidence credit globally is unsafe."
    },
    "role_missing_from_supplied_input": {
      "evidence_availability": "missing",
      "available_evidence": "Source values and storage type are unavailable; source names do not mark description-vs-code role. Archived publisher crosswalk assigns different meanings to deceptively same field names. Requires richer metadata or user confirmation; exact-name heuristics alone cannot prove equivalence."
    },
    "semantic_alias_requires_external_context": {
      "evidence_availability": "partial",
      "available_evidence": "Some concept or entity-role words overlap, but replacements such as recipient/legal_entity, acquisition_program/program_system_or_equipment, or fsrs_report_id/internal_id lack sufficient current input evidence. Archived publisher crosswalk supports the labels; no samples and Unknown source type."
    },
    "generic_identifier_alias_without_entity_role": {
      "evidence_availability": "partial",
      "available_evidence": "id/key canonicalization makes a generic object identifier equal a lookup key. Entity/identifier scope is missing from input, although different surface names warn of uncertainty."
    },
    "generic_quantity_missing_semantic_scope": {
      "evidence_availability": "partial",
      "available_evidence": "amount is compatible with multiple nested amount values. Path scopes distinguish base and tier/custom values, but source amount has no declared quantity role or samples. Publisher definition identifies the per-unit amount."
    },
    "representation_type_change": {
      "evidence_availability": "partial",
      "available_evidence": "Same complete path denotes start/end; source Integer versus target Timestamp loses all type credit, so a same-Integer speed candidate outranks it. Units/epoch conversion are documented externally; inferring every integer as temporal would be unsafe."
    },
    "unrelated_fuzzy_abbreviation": {
      "evidence_availability": "present",
      "available_evidence": "Flat amount/decimal and tiers mode are distinct roles in the actual field name. Skim subsequence fallback supplies overly strong name evidence despite unrelated words."
    }
  },
