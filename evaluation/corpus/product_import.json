    ],
    "target": [
      {
        "id": "t1",
        "name": "canonical_lot_id",
        "data_type": "Text",
        "concept": "supplier production lot identifier",
        "samples": [
          "LOT-M36",
          "LOT-M12",
          "LOT-M24"
        ]
      },
      {
        "id": "t2",
        "name": "product_id",
        "data_type": "Text",
        "concept": "merchant product identifier",
        "samples": [
          "P-903",
