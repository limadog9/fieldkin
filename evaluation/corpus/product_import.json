[
  {
    "id": "product_01",
    "domain": "product_import",
    "title": "Storefront inventory import",
    "tags": [
      "renamed",
      "unequal_sizes",
      "reordered"
    ],
    "rationale": "A merchant migrates its flat inventory table into a storefront catalog. Product identifiers and supplier identifiers remain separate; currency exists only in the destination. Original synthetic scenario; all identifiers and values were invented for this corpus.",
    "source": [
      {
        "id": "s1",
        "name": "SKU_Code",
        "data_type": "Text",
        "concept": "merchant product identifier",
        "samples": [
          "SKU-R41",
          "SKU-T62",
          "SKU-B83"
        ]
      },
      {
        "id": "s2",
        "name": "ProductTitle",
        "data_type": "Text",
        "concept": "public product display title",
        "samples": [
          "Copper desk clip",
          "Wool travel pouch",
          "Cork pen stand"
        ]
      },
      {
        "id": "s3",
        "name": "UnitPrice",
        "data_type": "Decimal",
        "concept": "retail unit price excluding sales tax",
        "samples": [
          12.5,
          24,
          8.75
        ]
      },
      {
        "id": "s4",
        "name": "OnHandQty",
        "data_type": "Integer",
        "concept": "physical units currently in stock",
        "samples": [
          14,
          8,
          39
        ]
      },
      {
        "id": "s5",
        "name": "Discontinued",
        "data_type": "Boolean",
        "concept": "product permanently withdrawn from future restocking",
        "samples": [
          false,
          true,
          false
        ]
      },
      {
        "id": "s6",
        "name": "VendorRef",
        "data_type": "Text",
        "concept": "supplier organization identifier",
        "samples": [
          "V-021",
          "V-039",
          "V-052"
        ]
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "product_id",
        "data_type": "Text",
        "concept": "merchant product identifier",
        "samples": [
          "SKU-B83",
          "SKU-R41",
          "SKU-T62"
        ]
      },
      {
        "id": "t2",
        "name": "stock_count",
        "data_type": "Integer",
        "concept": "physical units currently in stock",
        "samples": [
          39,
          14,
          8
        ]
      },
      {
        "id": "t3",
        "name": "display_name",
        "data_type": "Text",
        "concept": "public product display title",
        "samples": [
          "Cork pen stand",
          "Copper desk clip",
          "Wool travel pouch"
        ]
      },
      {
        "id": "t4",
        "name": "supplier_code",
        "data_type": "Text",
        "concept": "supplier organization identifier",
        "samples": [
          "V-052",
          "V-021",
          "V-039"
        ]
      },
      {
        "id": "t5",
        "name": "unit_price",
        "data_type": "Decimal",
        "concept": "retail unit price excluding sales tax",
        "samples": [
          8.75,
          12.5,
          24
        ]
      },
      {
        "id": "t6",
        "name": "is_discontinued",
        "data_type": "Boolean",
        "concept": "product permanently withdrawn from future restocking",
        "samples": [
          false,
          false,
          true
        ]
      },
      {
        "id": "t7",
        "name": "currency",
        "data_type": "Text",
        "concept": "retail pricing currency",
        "samples": [
          "USD",
          "USD",
          "USD"
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both identify the same merchant product; vendor identity is a different fact."
      },
      {
        "source": "s2",
        "kind": "match",
        "targets": [
          "t3"
        ],
        "rationale": "Both are the public product display title."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t5"
        ],
        "rationale": "Both are the same tax-exclusive retail unit price."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t2"
        ],
        "rationale": "Both count physical inventory units, not shipments or reservations."
      },
      {
        "source": "s5",
        "kind": "match",
        "targets": [
          "t6"
        ],
        "rationale": "Both indicate permanent discontinuation, with the same Boolean meaning."
      },
      {
        "source": "s6",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both contain the supplier organization identifier."
      }
    ]
  },
  {
    "id": "product_02",
    "domain": "product_import",
    "title": "Warehouse receipt and case counts",
    "tags": [
      "renamed",
      "misleading_qualifiers",
      "unequal_sizes",
      "empty_samples"
    ],
    "rationale": "Receiving records identify an intake, storage bin and supplier lot. Cases received and individual units received are different measurements, and no case-to-unit conversion is supplied. Original synthetic scenario; all identifiers and values were invented for this corpus.",
    "source": [
      {
        "id": "s1",
        "name": "intake_id",
        "data_type": "Text",
        "concept": "warehouse receipt identifier",
        "samples": [
          "RCV-102",
          "RCV-109",
          "RCV-114"
        ]
      },
      {
        "id": "s2",
        "name": "receipt_date",
        "data_type": "Date",
        "concept": "calendar day goods were received",
        "samples": [
          "2026-02-04",
          "2026-02-06",
          "2026-02-07"
        ]
      },
      {
        "id": "s3",
        "name": "slot_label",
        "data_type": "Text",
        "concept": "physical storage bin identifier",
        "samples": [
          "R2-B1",
          "R2-B4",
          "R3-B2"
        ]
      },
      {
        "id": "s4",
        "name": "lot_id",
        "data_type": "Text",
        "concept": "supplier production lot identifier",
        "samples": [
          "LT-K7",
          "LT-M8",
          "LT-P9"
        ]
      },
      {
        "id": "s5",
        "name": "case_count",
        "data_type": "Integer",
        "concept": "number of cartons received",
        "samples": [
          2,
          3,
          5
        ]
      },
      {
        "id": "s6",
        "name": "receiving_note",
        "data_type": "Text",
        "concept": "freeform exception recorded at receipt",
        "samples": []
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "receipt_identifier",
        "data_type": "Text",
        "concept": "warehouse receipt identifier",
        "samples": [
          "RCV-109",
          "RCV-114",
          "RCV-102"
        ]
      },
      {
        "id": "t2",
        "name": "received_on",
        "data_type": "Date",
        "concept": "calendar day goods were received",
        "samples": [
          "2026-02-06",
          "2026-02-07",
          "2026-02-04"
        ]
      },
      {
        "id": "t3",
        "name": "storage_bin",
        "data_type": "Text",
        "concept": "physical storage bin identifier",
        "samples": [
          "R2-B4",
          "R3-B2",
          "R2-B1"
        ]
      },
      {
        "id": "t4",
        "name": "batch_id",
        "data_type": "Text",
        "concept": "supplier production lot identifier",
        "samples": [
          "LT-M8",
          "LT-P9",
          "LT-K7"
        ]
      },
      {
        "id": "t5",
        "name": "unit_count",
        "data_type": "Integer",
        "concept": "number of individual product units received",
        "samples": [
          24,
          36,
          60
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both are warehouse receipt identities."
      },
      {
        "source": "s2",
        "kind": "match",
        "targets": [
          "t2"
        ],
        "rationale": "Both record the arrival calendar day."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t3"
        ],
        "rationale": "Both identify the same physical bin."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both identify the supplier production lot."
      },
      {
        "source": "s5",
        "kind": "no_match",
        "targets": [],
        "rationale": "No destination stores cartons; unit_count counts individual items and needs an unknown pack-size transformation."
      },
      {
        "source": "s6",
        "kind": "no_match",
        "targets": [],
        "rationale": "The destination has no receiving-exception note field; absent sample contents do not establish a substitute."
      }
    ]
  },
  {
    "id": "product_03",
    "domain": "product_import",
    "title": "Apparel variant availability",
    "tags": [
      "renamed",
      "misleading_qualifiers",
      "constant_samples",
      "low_cardinality",
      "unequal_sizes"
    ],
    "rationale": "Clothing variants carry a style identifier, color, size and barcode. A backorder permission is not an in-stock availability flag, even when both are Boolean. Original synthetic scenario; all identifiers and values were invented for this corpus.",
    "source": [
      {
        "id": "s1",
        "name": "style_num",
        "data_type": "Text",
        "concept": "parent apparel style identifier",
        "samples": [
          "ST-201",
          "ST-205",
          "ST-208"
        ]
      },
      {
        "id": "s2",
        "name": "hue",
