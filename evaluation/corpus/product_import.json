        "name": "overflow_bin",
        "data_type": "Text",
        "concept": "overflow storage bin identifier",
        "samples": []
      },
      {
        "id": "t5",
        "name": "expiry_on",
        "data_type": "Date",
        "concept": "supplier lot expiration date",
        "samples": [
          "2027-03-31",
          "2027-01-31",
          "2027-02-28"
        ]
      },
      {
        "id": "t6",
        "name": "reserved_units",
        "data_type": "Integer",
        "concept": "individual units reserved for orders",
        "samples": [
          9,
          4,
          7
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
