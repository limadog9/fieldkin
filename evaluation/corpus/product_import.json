        "concept": "variant color name",
        "samples": [
          "Amber",
          "Moss",
          "Slate"
        ]
      },
      {
        "id": "s3",
        "name": "size_label",
        "data_type": "Text",
        "concept": "garment size designation",
        "samples": [
          "S",
          "M",
          "L"
        ]
      },
      {
        "id": "s4",
        "name": "ean",
        "data_type": "Text",
        "concept": "variant barcode identifier",
        "samples": [
          "9900000000101",
          "9900000000102",
          "9900000000103"
        ]
      },
      {
        "id": "s5",
        "name": "backorder_allowed",
        "data_type": "Boolean",
        "concept": "customer may order when stock is exhausted",
        "samples": [
          true,
          true,
          true
        ]
      },
      {
        "id": "s6",
        "name": "discontinued",
        "data_type": "Boolean",
        "concept": "variant withdrawn from future sale",
        "samples": [
          false,
          false,
          false
        ]
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "parent_style",
        "data_type": "Text",
        "concept": "parent apparel style identifier",
        "samples": [
          "ST-208",
          "ST-201",
          "ST-205"
        ]
      },
      {
        "id": "t2",
        "name": "colour",
        "data_type": "Text",
        "concept": "variant color name",
        "samples": [
          "Slate",
          "Amber",
          "Moss"
        ]
      },
      {
        "id": "t3",
        "name": "size",
        "data_type": "Text",
        "concept": "garment size designation",
        "samples": [
          "L",
          "S",
          "M"
        ]
      },
      {
        "id": "t4",
        "name": "barcode",
        "data_type": "Text",
        "concept": "variant barcode identifier",
        "samples": [
          "9900000000103",
          "9900000000101",
          "9900000000102"
        ]
      },
      {
        "id": "t5",
        "name": "available",
        "data_type": "Boolean",
        "concept": "variant has stock ready to ship",
        "samples": [
          true,
          true,
          true
        ]
      },
      {
        "id": "t6",
        "name": "is_discontinued",
        "data_type": "Boolean",
        "concept": "variant withdrawn from future sale",
        "samples": [
          false,
          false,
          false
        ]
      },
      {
        "id": "t7",
        "name": "catalog_season",
        "data_type": "Text",
        "concept": "fashion season identifier",
        "samples": [
          "F26",
          "F26",
          "F26"
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both refer to the parent style, not the individual barcode."
      },
      {
        "source": "s2",
        "kind": "match",
        "targets": [
          "t2"
        ],
        "rationale": "Both record the variant color."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t3"
        ],
        "rationale": "Both use the same garment-size designation."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both identify the individual variant using the same barcode."
      },
      {
        "source": "s5",
        "kind": "no_match",
        "targets": [],
        "rationale": "Backorder policy and immediate stock availability are independent facts; matching constant true samples are not evidence of equivalence."
      },
      {
        "source": "s6",
        "kind": "match",
        "targets": [
          "t6"
        ],
        "rationale": "Both use true to mean the variant has been discontinued."
      }
    ]
  },
  {
