    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both identify the FX trade."
      },
      {
        "source": "s2",
        "kind": "no_match",
        "targets": [],
        "rationale": "The destination stores quote-currency proceeds, not base-currency principal; rate application is outside a direct-field match."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t7"
        ],
        "rationale": "Both identify base currency. The identically named currency target denotes the different quote side."
      },
      {
        "source": "s4",
        "kind": "no_match",
        "targets": [],
        "rationale": "The only rate target has the reciprocal direction; the same heading does not make the quantities equivalent."
      },
      {
        "source": "s5",
        "kind": "match",
        "targets": [
          "t5"
        ],
        "rationale": "Both are trade execution instants."
      },
      {
        "source": "s6",
        "kind": "no_match",
        "targets": [],
