[
  {
    "id": "finance_01",
    "domain": "financial_records",
    "title": "Invoice total with undocumented tax scope",
    "tags": [
      "ambiguous",
      "misleading_qualifiers",
      "incompatible_types",
      "unequal_sizes"
    ],
    "rationale": "An invoice export labels a total only as amount and does not record whether tax is included. The target distinguishes gross and net totals. Discount in the source is a description of eligibility, not a monetary discount value. Original synthetic scenario; these are invented business records, not financial guidance or records of real people.",
    "source": [
      {
        "id": "s1",
        "name": "invoice_num",
        "data_type": "Text",
        "concept": "invoice identifier",
        "samples": [
          "INV-101",
          "INV-107",
          "INV-112"
        ]
      },
      {
        "id": "s2",
        "name": "amount",
        "data_type": "Decimal",
        "concept": "undocumented invoice total: before or after tax",
        "samples": []
      },
      {
        "id": "s3",
        "name": "date",
        "data_type": "Date",
        "concept": "invoice issue date",
        "samples": [
          "2026-01-08",
          "2026-01-14",
          "2026-01-22"
        ]
      },
      {
        "id": "s4",
        "name": "ISO_currency",
        "data_type": "Text",
        "concept": "currency in which the invoice is denominated",
        "samples": [
          "EUR",
          "GBP",
          "USD"
        ]
      },
      {
        "id": "s5",
        "name": "paid",
        "data_type": "Boolean",
        "concept": "invoice is fully paid",
        "samples": [
          true,
          false,
          true
        ]
      },
      {
        "id": "s6",
        "name": "discount",
        "data_type": "Text",
        "concept": "description of discount eligibility",
        "samples": [
          "early payment",
          "member rate",
          "none"
        ]
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "invoice_id",
        "data_type": "Text",
        "concept": "invoice identifier",
        "samples": [
          "INV-112",
          "INV-101",
          "INV-107"
        ]
      },
      {
        "id": "t2",
        "name": "gross_amount",
        "data_type": "Decimal",
        "concept": "invoice total including tax",
        "samples": []
      },
      {
        "id": "t3",
        "name": "net_amount",
        "data_type": "Decimal",
        "concept": "invoice total excluding tax",
        "samples": []
      },
      {
        "id": "t4",
        "name": "invoice_date",
        "data_type": "Date",
        "concept": "invoice issue date",
        "samples": [
          "2026-01-22",
          "2026-01-08",
          "2026-01-14"
        ]
      },
      {
        "id": "t5",
        "name": "currency",
        "data_type": "Text",
        "concept": "currency in which the invoice is denominated",
        "samples": [
          "USD",
          "EUR",
          "GBP"
        ]
      },
      {
        "id": "t6",
        "name": "is_paid",
        "data_type": "Boolean",
        "concept": "invoice is fully paid",
        "samples": [
          true,
          true,
          false
        ]
      },
      {
        "id": "t7",
        "name": "discount",
        "data_type": "Decimal",
        "concept": "monetary discount deducted from the invoice",
        "samples": [
          5,
          10,
          0
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both are the same invoice identity."
      },
      {
        "source": "s2",
        "kind": "ambiguous",
        "targets": [
          "t2",
          "t3"
        ],
        "rationale": "Tax scope is undocumented and samples are empty, so neither gross nor net total is a justified unique selection."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both are invoice issue dates."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t5"
        ],
        "rationale": "Both are invoice denomination currencies."
      },
      {
        "source": "s5",
        "kind": "match",
        "targets": [
          "t6"
        ],
        "rationale": "Both indicate full invoice payment."
      },
      {
        "source": "s6",
        "kind": "no_match",
        "targets": [],
        "rationale": "Discount eligibility text is not the monetary discount amount; no target stores the eligibility description."
      }
    ]
  },
  {
    "id": "finance_02",
    "domain": "financial_records",
    "title": "Card capture versus merchant settlement",
    "tags": [
      "misleading_qualifiers",
      "renamed",
      "low_cardinality"
    ],
    "rationale": "A gateway capture feed must join a merchant settlement table. Gross captured money differs from settlement net of fees, and authorization outcome differs from the later settlement status. Original synthetic scenario; these are invented business records, not financial guidance or records of real people.",
    "source": [
      {
        "id": "s1",
        "name": "payment_ref",
        "data_type": "Text",
        "concept": "gateway payment identifier",
        "samples": [
          "PAY-K01",
          "PAY-K08",
          "PAY-K16"
        ]
      },
      {
        "id": "s2",
        "name": "GrossAmt",
        "data_type": "Decimal",
        "concept": "gross money captured from the cardholder",
        "samples": [
          105,
          210,
          315
        ]
      },
      {
        "id": "s3",
        "name": "fee",
        "data_type": "Decimal",
        "concept": "gateway fee charged for the payment",
        "samples": [
          5,
          10,
          15
        ]
      },
      {
        "id": "s4",
        "name": "currency",
        "data_type": "Text",
        "concept": "payment denomination currency",
        "samples": [
          "USD",
          "CAD",
          "EUR"
        ]
      },
      {
        "id": "s5",
        "name": "TransDate",
        "data_type": "Date",
        "concept": "calendar date the payment was captured",
        "samples": [
          "2026-02-03",
          "2026-02-07",
          "2026-02-11"
        ]
      },
      {
        "id": "s6",
        "name": "status",
        "data_type": "Text",
        "concept": "authorization outcome",
        "samples": [
          "approved",
          "declined",
          "approved"
        ]
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "payment_id",
        "data_type": "Text",
        "concept": "gateway payment identifier",
        "samples": [
          "PAY-K16",
          "PAY-K01",
          "PAY-K08"
        ]
      },
      {
        "id": "t2",
        "name": "amount",
        "data_type": "Decimal",
        "concept": "net settlement proceeds after gateway fees",
        "samples": [
          300,
          100,
          200
        ]
      },
      {
        "id": "t3",
        "name": "service_fee",
        "data_type": "Decimal",
        "concept": "gateway fee charged for the payment",
        "samples": [
          15,
          5,
          10
        ]
      },
      {
        "id": "t4",
        "name": "currency_code",
        "data_type": "Text",
        "concept": "payment denomination currency",
        "samples": [
          "EUR",
          "USD",
          "CAD"
        ]
      },
      {
        "id": "t5",
        "name": "transaction_date",
        "data_type": "Date",
        "concept": "calendar date the payment was captured",
        "samples": [
          "2026-02-11",
          "2026-02-03",
          "2026-02-07"
        ]
      },
      {
        "id": "t6",
        "name": "status",
        "data_type": "Text",
        "concept": "settlement processing status",
        "samples": [
          "settled",
          "held",
          "pending"
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both identify the gateway payment."
      },
      {
        "source": "s2",
        "kind": "no_match",
        "targets": [],
        "rationale": "No target stores captured gross money; amount contains the distinct net settlement proceeds."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t3"
        ],
        "rationale": "Both store the gateway fee for this payment."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both are the payment denomination currency."
      },
      {
        "source": "s5",
        "kind": "match",
        "targets": [
          "t5"
        ],
        "rationale": "Both are capture dates, not settlement dates."
      },
      {
        "source": "s6",
        "kind": "no_match",
        "targets": [],
        "rationale": "Authorization outcome and settlement processing status describe different workflow stages."
      }
    ]
  },
  {
