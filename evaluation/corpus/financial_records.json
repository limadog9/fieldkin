          "pending"
        ]
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "trade_id",
        "data_type": "Text",
        "concept": "foreign-exchange trade identifier",
        "samples": [
          "FX-T117",
          "FX-T101",
          "FX-T109"
        ]
      },
      {
        "id": "t2",
        "name": "amount",
        "data_type": "Decimal",
        "concept": "proceeds amount in quote currency",
