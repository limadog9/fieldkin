        ]
      },
      {
        "id": "t5",
        "name": "executed_at",
        "data_type": "Timestamp",
        "concept": "instant the trade was executed",
        "samples": [
          "2026-04-04T12:00:00Z",
          "2026-04-02T10:00:00Z",
          "2026-04-03T11:00:00Z"
        ]
      },
      {
        "id": "t6",
        "name": "settled",
        "data_type": "Date",
        "concept": "calendar date actual settlement completed",
        "samples": [
          null,
          null,
          "2026-04-05"
        ]
      },
      {
        "id": "t7",
        "name": "base_currency",
        "data_type": "Text",
        "concept": "base currency of the trade",
        "samples": [
          "CAD",
          "EUR",
          "GBP"
        ]
      }
