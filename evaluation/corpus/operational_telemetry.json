[
  {
    "id": "telemetry_01",
    "domain": "operational_telemetry",
    "title": "A pump station uses explicit engineering units",
    "tags": [
      "renamed",
      "misleading_names",
      "units",
      "unequal_sizes",
      "no_match"
    ],
    "rationale": "Original synthetic pump-station feed. Correspondences preserve quantity and unit. Celsius and Fahrenheit temperatures, and kilopascals versus pascals, are different representations requiring conversion and are not accepted as direct field correspondences.",
