  {
    "id": "telemetry_02",
    "domain": "operational_telemetry",
    "title": "Host resource counters cannot be substituted for gauges or rates",
    "tags": [
      "misleading_names",
      "units",
      "incompatible_types",
      "no_match"
    ],
    "rationale": "Original synthetic host-monitoring export. CPU utilization and load average are distinct measurements; a cumulative request counter is not a request rate. Values include superficially similar magnitudes, but semantics and units establish the labels.",
    "source": [
      {
        "id": "s1",
        "name": "CPUPercent",
        "data_type": "Float",
        "concept": "processor utilization in percent",
        "samples": [
          35,
          42,
          57
        ]
      },
      {
        "id": "s2",
        "name": "LoadAverage",
        "data_type": "Float",
        "concept": "one-minute runnable-process load",
        "samples": [
          0.35,
          0.42,
          0.57
        ]
      },
      {
        "id": "s3",
        "name": "RequestTotal",
        "data_type": "Integer",
        "concept": "cumulative accepted-request count",
        "samples": [
          1200,
          1220,
          1250
        ]
      },
      {
        "id": "s4",
        "name": "MemoryBytes",
        "data_type": "Integer",
        "concept": "resident memory use in bytes",
        "samples": [
          4096,
          8192,
          16384
        ]
      },
      {
        "id": "s5",
        "name": "UptimeSeconds",
        "data_type": "Integer",
        "concept": "elapsed host uptime in seconds",
        "samples": [
          10,
          20,
          30
        ]
      },
      {
        "id": "s6",
        "name": "Status",
        "data_type": "Text",
        "concept": "multistate collector health label",
        "samples": [
          "ok",
          "warning",
          "offline"
        ]
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "cpu_utilization_percent",
        "data_type": "Float",
        "concept": "processor utilization in percent",
        "samples": [
          35,
          42,
          57
        ]
      },
      {
        "id": "t2",
        "name": "cpu_load",
        "data_type": "Float",
        "concept": "one-minute runnable-process load",
        "samples": [
          0.35,
          0.42,
          0.57
        ]
      },
      {
        "id": "t3",
        "name": "request_rate",
        "data_type": "Float",
        "concept": "accepted requests per second",
        "samples": [
          20,
          30,
          25
        ]
      },
      {
        "id": "t4",
        "name": "memory_bytes",
        "data_type": "Integer",
        "concept": "resident memory use in bytes",
        "samples": [
          4096,
          8192,
          16384
        ]
      },
      {
        "id": "t5",
        "name": "uptime_ms",
        "data_type": "Integer",
        "concept": "elapsed host uptime in milliseconds",
        "samples": [
          10000,
          20000,
          30000
        ]
      },
      {
        "id": "t6",
        "name": "status",
        "data_type": "Boolean",
        "concept": "collector is reachable",
        "samples": [
          true,
          true,
          false
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both gauges measure CPU utilization in percent."
      },
      {
        "source": "s2",
        "kind": "match",
        "targets": [
          "t2"
        ],
        "rationale": "Both gauges measure one-minute load, which is not CPU percent."
      },
      {
        "source": "s3",
        "kind": "no_match",
        "targets": [],
        "rationale": "A cumulative counter cannot directly map to a per-second rate."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both gauges measure the same resident byte count."
      },
      {
        "source": "s5",
        "kind": "no_match",
        "targets": [],
        "rationale": "Only a millisecond representation exists in the target; direct matching excludes conversion."
      },
      {
        "source": "s6",
        "kind": "no_match",
        "targets": [],
        "rationale": "A three-state health label and a reachability boolean represent different information."
      }
    ]
  },
  {
    "id": "telemetry_03",
