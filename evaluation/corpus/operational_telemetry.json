        "samples": [
          101,
          102,
          103
        ]
      },
      {
        "id": "t5",
        "name": "boot_id",
        "data_type": "Text",
        "concept": "software deployment identifier",
        "samples": [
          "a1",
          "b2",
          "c3"
        ]
      },
      {
        "id": "t6",
        "name": "event_id",
        "data_type": "Text",
        "concept": "container instance identifier",
        "samples": [
          "a1",
          "b2",
          "c3"
        ]
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "match",
        "targets": [
          "t1"
        ],
        "rationale": "Both IDs identify the full distributed trace."
      },
      {
        "source": "s2",
        "kind": "match",
        "targets": [
          "t2"
        ],
        "rationale": "Both IDs identify the span inside a trace, not the enclosing trace."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t3"
        ],
        "rationale": "Both IDs identify the same physical host namespace."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both integer IDs identify operating-system processes."
      },
      {
        "source": "s5",
        "kind": "no_match",
        "targets": [],
        "rationale": "The destination's historical boot_id name actually refers to software deployment, not host boot sessions."
      },
      {
        "source": "s6",
        "kind": "no_match",
        "targets": [],
        "rationale": "The destination's historical event_id name actually identifies containers, not events."
      }
    ]
  },
