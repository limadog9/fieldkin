        "data_type": "Text",
        "concept": "host boot-session identifier",
        "samples": [
          "a1",
          "b2",
          "c3"
        ]
      },
      {
        "id": "s6",
        "name": "EventID",
        "data_type": "Text",
        "concept": "individual telemetry event identifier",
        "samples": [
          "a1",
          "b2",
          "c3"
        ]
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "trace_id",
        "data_type": "Text",
        "concept": "distributed trace identifier",
        "samples": [
          "a1",
          "b2",
          "c3"
        ]
      },
      {
        "id": "t2",
        "name": "span_id",
        "data_type": "Text",
        "concept": "span identifier within a trace",
        "samples": [
          "a1",
          "b2",
          "c3"
        ]
      },
      {
        "id": "t3",
        "name": "host_id",
        "data_type": "Text",
        "concept": "physical host identifier",
        "samples": [
          "h1",
          "h2",
          "h3"
        ]
      },
      {
        "id": "t4",
        "name": "process_id",
        "data_type": "Integer",
