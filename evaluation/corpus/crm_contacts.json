          true,
          true,
          true
        ]
      },
      {
        "id": "t5",
        "name": "consent_at",
        "data_type": "Timestamp",
        "concept": "time marketing-mail consent was granted",
        "samples": [
          "2026-01-02T12:00:00Z",
          "2026-01-03T13:00:00Z",
          "2026-01-04T14:00:00Z"
        ]
      },
      {
        "id": "t6",
        "name": "policy_version",
        "data_type": "Text",
        "concept": "consent policy revision",
        "samples": [
          "r7",
          "r7",
          "r7"
        ]
      },
      {
        "id": "t7",
