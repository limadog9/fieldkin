  {
    "id": "crm_02",
    "domain": "crm_contacts",
    "title": "Two unlabeled mailbox columns in an emergency-contact export",
    "tags": [
      "duplicate_names",
      "ambiguous",
      "low_cardinality",
      "empty_samples"
    ],
    "rationale": "Original synthetic emergency-contact migration. Two historical columns have the identical display name Email and no surviving channel designation. The target distinguishes personal and work addresses, but observed address samples coincide. Neither source mailbox can be assigned a channel from the supplied evidence.",
    "source": [
      {
        "id": "s1",
        "name": "Email",
        "data_type": "Text",
        "concept": "mailbox with lost channel designation",
        "samples": [
          "shared@example.invalid",
          "shared@example.invalid",
          "shared@example.invalid"
        ]
      },
      {
        "id": "s2",
        "name": "Email",
        "data_type": "Text",
        "concept": "second mailbox with lost channel designation",
        "samples": [
          "shared@example.invalid",
          "shared@example.invalid",
          "shared@example.invalid"
        ]
      },
      {
        "id": "s3",
        "name": "EmergencyPhone",
        "data_type": "Text",
        "concept": "emergency-contact telephone",
        "samples": [
          "+1-202-555-0171",
          "+1-202-555-0172",
          "+1-202-555-0173"
        ]
      },
      {
        "id": "s4",
        "name": "PostalCode",
        "data_type": "Text",
        "concept": "mailing postal code",
        "samples": [
          "02139",
          "10003",
          "97202"
        ]
      },
      {
        "id": "s5",
        "name": "BirthDate",
        "data_type": "Date",
        "concept": "contact date of birth",
        "samples": [
          "1988-04-01",
          "1992-08-12",
          "1979-12-03"
        ]
      },
      {
        "id": "s6",
        "name": "PreferredLanguage",
        "data_type": "Text",
        "concept": "preferred correspondence language",
        "samples": []
      }
    ],
    "target": [
      {
        "id": "t1",
        "name": "Email",
        "data_type": "Text",
        "concept": "personal mailbox",
        "samples": [
          "shared@example.invalid",
          "shared@example.invalid",
          "shared@example.invalid"
        ]
      },
      {
        "id": "t2",
        "name": "Email",
        "data_type": "Text",
        "concept": "work mailbox",
        "samples": [
          "shared@example.invalid",
          "shared@example.invalid",
          "shared@example.invalid"
        ]
      },
      {
        "id": "t3",
        "name": "emergency_phone",
        "data_type": "Text",
        "concept": "emergency-contact telephone",
        "samples": [
          "+1-202-555-0171",
          "+1-202-555-0172",
          "+1-202-555-0173"
        ]
      },
      {
        "id": "t4",
        "name": "postal_code",
        "data_type": "Text",
        "concept": "mailing postal code",
        "samples": [
          "02139",
          "10003",
          "97202"
        ]
      },
      {
        "id": "t5",
        "name": "birth_date",
        "data_type": "Date",
        "concept": "contact date of birth",
        "samples": [
          "1988-04-01",
          "1992-08-12",
          "1979-12-03"
        ]
      },
      {
        "id": "t6",
        "name": "preferred_language",
        "data_type": "Text",
        "concept": "preferred correspondence language",
        "samples": []
      }
    ],
    "labels": [
      {
        "source": "s1",
        "kind": "ambiguous",
        "targets": [
          "t1",
          "t2"
        ],
        "rationale": "Channel metadata is lost and equal address observations cannot select personal versus work."
      },
      {
        "source": "s2",
        "kind": "ambiguous",
        "targets": [
          "t1",
          "t2"
        ],
        "rationale": "The second stable source ID does not restore its missing channel designation."
      },
      {
        "source": "s3",
        "kind": "match",
        "targets": [
          "t3"
        ],
        "rationale": "This is the emergency contact number, not either mailbox."
      },
      {
        "source": "s4",
        "kind": "match",
        "targets": [
          "t4"
        ],
        "rationale": "Both fields contain mailing postal codes, including leading zeros."
      },
      {
        "source": "s5",
        "kind": "match",
        "targets": [
          "t5"
        ],
        "rationale": "Both calendar dates refer to the contact's birth."
      },
      {
        "source": "s6",
        "kind": "match",
        "targets": [
          "t6"
        ],
        "rationale": "The same language preference is named explicitly despite an empty observed sample."
