    "target": [
      {
        "id": "t1",
        "name": "marketing_email_allowed",
        "data_type": "Boolean",
        "concept": "permission to send marketing mail",
        "samples": [
          true,
          true,
          true
        ]
      },
      {
        "id": "t2",
        "name": "active",
        "data_type": "Boolean",
        "concept": "loyalty membership is current",
        "samples": [
          true,
          true,
